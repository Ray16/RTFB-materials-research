# cluster.env — single source of truth for lambda-cluster GPU submission policy.
# Sourced by fleet scripts (gpu_guard.sh, gpu_watchdog.sh, *_fleet_worker.sh) and parsed by
# scripts/free_gpus.py. Keep it plain KEY="value" (no logic) so Python can read it too.
#
# POLICY (see CLAUDE.md "Submitting GPU jobs"): never submit onto a GPU another user is on,
# never onto a RESERVED host, and never more than one of our tasks per GPU.

# Hosts we are allowed to place jobs on (space-separated). Reachable GPU nodes only.
# lambda13 is a NORMAL usable node like any other — the ONLY rule is: never contend with another
# user (enforced by the ownership check + auto-yield below), not a whole-host reservation.
ALLOWED_HOSTS="lambda0 lambda1 lambda2 lambda4 lambda5 lambda6 lambda11 lambda12 lambda13"

# Hosts we cannot use at all (not policy — practically unusable): lambda3 is usually down;
# lambda9 does not mount our home dir so the env won't run there.
RESERVED_HOSTS="lambda3 lambda9"

# A GPU counts as free ONLY if utilization <= UTIL_MAX (%) AND used memory <= MEM_MAX (MiB)
# AND no process owned by another user is resident on it (ownership check in gpu_probe.sh).
UTIL_MAX="5"
MEM_MAX="500"

# In-worker auto-yield: how often (seconds) the sentinel re-checks its GPU for a foreign job.
SENTINEL_INTERVAL="20"

# Watchdog: how often (seconds) the cluster-wide collision scan runs. 120s keeps ssh chatter low
# while still catching contention within ~2 min (contention shorter than that self-resolves).
WATCHDOG_INTERVAL="120"
