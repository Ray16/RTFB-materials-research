*.chk
*.fchk
*.molden
*.cube
*.hdf5
*.h5
*.wfn
*.wfx
*.log

# Conda / venv
.venv/
env/

# Scratch, runtime locks & OS
scratch/
tmp/
logs/
*.lock
.DS_Store

# Secrets — never commit tokens
*.token
.env

# Transient test / migration reports under validation/ (the committed Nitro
# evidence under validation/nitro_prior/ and validation/nitro_environment.json
# are .json and are kept explicitly).
validation/*.xml

# Licensed / non-redistributable curated data (re-create via docs/DATASETS.md)
data/raw/validation/solvation_refset_acetonitrile.csv
